# ============================================================
# ShopAssist AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# Supabase PostgreSQL — Primary database connection (via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DATABASE_URL=your_supabase_pooled_connection_string_here

# Supabase PostgreSQL — Direct connection (used by Prisma migrations)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=your_supabase_direct_connection_string_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=shopassist-kb
