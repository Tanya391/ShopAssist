# ============================================================
# ShopAssist AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# Gemini AI Configurations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Gemini API Safety & Rate Limiting
GEMINI_RATE_LIMIT_ENABLED=true
GEMINI_RPM_LIMIT=10
GEMINI_MAX_CALLS_PER_REQUEST=3
GEMINI_QUEUE_TIMEOUT_MS=60000
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MAX_TOOL_CALLS_PER_REQUEST=2
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_CIRCUIT_COOLDOWN_MS=300000

# Express Server Rate Limiting
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=10

# Security & CORS
ADMIN_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Context Bounds
MAX_HISTORY_MESSAGES=10
MAX_QUERY_LENGTH=4000

# Pinecone Vector Database Configurations
PINECONE_API_KEY=
PINECONE_INDEX=shopassist-kb

# Prisma / PostgreSQL Configurations
DATABASE_URL=
DIRECT_URL=
